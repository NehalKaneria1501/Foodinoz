rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. User Profiles & all sub-collections
    // (orders, wishlist, shopping_list, meal_plans, ai_chat_history)
    match /users/{userId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // 2. Centralized Orders Dispatch (Root collection)
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // 3. Public Products Catalog
    match /products/{productId} {
      allow read, write: if true;
    }

    // 4. Public Recipes Catalog
    match /recipes/{recipeId} {
      allow read, write: if true;
    }

    // 5. Dark Stores & Express Hubs
    match /dark_stores/{storeId} {
      allow read, write: if true;
    }

    // 6. Global AI Chat History (if accessed at root)
    match /ai_chat_history/{msgId} {
      allow read, write: if true;
    }
  }
}
